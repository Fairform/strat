// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  email     String   @unique
  password  String
  name      String?
  role      String   @default("manager") // manager, owner, tenant, admin
  companyName String? @map("company_name")
  phone     String?
  verified  Boolean  @default(false)
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")

  // Subscription
  stripeCustomerId String? @unique @map("stripe_customer_id")
  subscriptionId   String? @unique @map("subscription_id")
  subscriptionStatus String? @map("subscription_status") // active, canceled, past_due, trialing
  plan             String? // start, scale, pro
  planUnitLimit    Int?    @map("plan_unit_limit")
  trialEndsAt      DateTime? @map("trial_ends_at")
  subscriptionEndsAt DateTime? @map("subscription_ends_at")

  // Relations
  buildings    Building[]
  properties   Property[]
  meetings     Meeting[]
  documents    Document[]
  notifications Notification[]
  tenantCommunications TenantCommunication[]

  @@map("users")
}

model Building {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  name       String
  street     String?
  city       String?
  state      String?
  postcode   String?
  unitCount  Int?     @map("unit_count")
  buildingType String? @map("building_type") // residential, commercial, mixed
  strataPlanNumber String? @map("strata_plan_number")

  managerName  String? @map("manager_name")
  managerEmail String? @map("manager_email")
  managerPhone String? @map("manager_phone")

  // Relations
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  meetings  Meeting[]
  documents Document[]

  @@map("buildings")
}

model Meeting {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  // Form data
  buildingSize String   @map("building_size")
  state        String
  meetingType  String   @map("meeting_type")
  buildingName String   @map("building_name")
  meetingDate  DateTime @map("meeting_date")
  email        String

  // File info
  uploadUrl    String?  @map("upload_url")
  fileName     String?  @map("file_name")
  fileSize     BigInt?  @map("file_size")

  // Processing
  status       String   @default("pending") // pending, processing, completed, failed
  processedAt  DateTime? @map("processed_at")
  transcription Text?
  errorMessage String? @map("error_message")

  // Payment
  stripeSessionId String? @unique @map("stripe_session_id")
  stripePaymentId String? @map("stripe_payment_id")
  amountPaid      Int?    @map("amount_paid") // in cents

  // Output
  minutesDocxUrl String? @map("minutes_docx_url")
  minutesPdfUrl  String? @map("minutes_pdf_url")

  // Relations
  userId     String?  @map("user_id")
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  buildingId String?  @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@map("meetings")
}

model Document {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  name      String
  fileUrl   String   @map("file_url")
  fileSize  BigInt?  @map("file_size")
  fileType  String?  @map("file_type")
  category  String?  // minutes, financial, plans, compliance, contracts, correspondence, other

  // Relations
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  buildingId String?  @map("building_id")
  building   Building? @relation(fields: [buildingId], references: [id], onDelete: SetNull)

  @@map("documents")
}

model Notification {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  title     String
  message   String
  type      String   @default("info") // info, success, warning, error
  read      Boolean  @default(false)
  link      String?

  // Relations
  userId    String   @map("user_id")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Property {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Property details
  name        String
  address     String
  city        String?
  state       String?
  postcode    String?
  propertyType String @map("property_type") // apartment, townhouse, house

  // Build-to-rent specific
  totalUnits  Int      @map("total_units")
  occupiedUnits Int    @default(0) @map("occupied_units")
  completionDate DateTime? @map("completion_date")

  // Financials
  averageRent Decimal? @map("average_rent") @db.Decimal(10, 2)
  totalRevenue Decimal? @map("total_revenue") @db.Decimal(12, 2)

  // Status
  status      String   @default("active") // active, inactive, development

  // Relations
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  units       Unit[]
  tenantCommunications TenantCommunication[]

  @@map("properties")
}

model Unit {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Unit details
  unitNumber  String   @map("unit_number")
  floor       Int?
  bedrooms    Int
  bathrooms   Decimal  @db.Decimal(3, 1)
  squareMeters Decimal? @map("square_meters") @db.Decimal(8, 2)

  // Tenancy
  tenantName  String?  @map("tenant_name")
  tenantEmail String?  @map("tenant_email")
  tenantPhone String?  @map("tenant_phone")
  leaseStart  DateTime? @map("lease_start")
  leaseEnd    DateTime? @map("lease_end")
  rentAmount  Decimal?  @map("rent_amount") @db.Decimal(10, 2)

  // Status
  status      String   @default("vacant") // vacant, occupied, maintenance

  // Relations
  propertyId  String   @map("property_id")
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("units")
}

model TenantCommunication {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now()) @map("created_at")

  subject   String
  message   String   @db.Text
  type      String   // email, sms, notification
  status    String   @default("sent") // draft, sent, failed
  sentAt    DateTime? @map("sent_at")

  // Recipients
  recipientType String @map("recipient_type") // all, property, unit, individual
  recipientEmails String[] @map("recipient_emails")

  // Relations
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  propertyId String?  @map("property_id")
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: SetNull)

  @@map("tenant_communications")
}
